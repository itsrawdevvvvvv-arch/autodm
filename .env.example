# ============================================================
#  AutoDM — configuration
#  Copy this file to .env and fill in the values.
# ============================================================

# ---- Server ----
PORT=3000
# Public HTTPS URL of THIS server (used as the OAuth redirect + webhook URL).
# For local testing use a tunnel, e.g. https://xxxx.loca.lt
PUBLIC_URL=http://localhost:3000

# ---- Meta app (from developers.facebook.com > your app > Settings > Basic) ----
META_APP_ID=
META_APP_SECRET=

# Which login route you set up:
#   "instagram"  = Instagram API with Instagram Login  (no Facebook Page needed)
#   "facebook"   = Messenger API support for Instagram (needs a linked Facebook Page)
LOGIN_ROUTE=instagram

# ---- Webhook ----
# Any random string you invent; paste the same into the App Dashboard.
WEBHOOK_VERIFY_TOKEN=change-me

# ---- Access key (recommended once this is on a public URL) ----
# Any string. The dashboard asks for it once and stores it in the browser.
# Leave empty for a local-only instance.
APP_KEY=

# ---- Safety caps ----
MAX_SENDS_PER_HOUR=200
MESSAGING_WINDOW_HOURS=24
